#!/usr/bin/env python3
"""Launcher so a clone works as `bin/vole` or via PATH without installing."""
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)
from vole.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
