#!/usr/bin/env python3
"""Launcher so a clone works as `bin/vole` or via PATH without installing."""
import os
import sys

# realpath: when ~/.local/bin/vole → repo/bin/vole, abspath alone lands in ~/.local.
ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, ROOT)
from vole.cli import main  # noqa: E402

if __name__ == '__main__':
    sys.exit(main())
