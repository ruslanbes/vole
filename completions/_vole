#compdef vole
# zsh completion for vole — dynamic names via `vole complete names`.
# Installed to ~/.zsh/completions (curl/install.sh) or Homebrew's zsh completion dir.

_vole_names() {
  local -a names
  local prefix=${words[CURRENT]}
  # Drop a leading dash so we don't treat flags as name prefixes.
  [[ $prefix == -* ]] && return 0
  names=(${(f)"$(command vole complete names -- "$prefix" 2>/dev/null)"})
  (( $#names )) && compadd -a names
}

_vole() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'help:show help'
    'scan:scan the machine and update inventory'
    'list:table of installed software'
    'get:show one inventory entry'
    'why:print or set why'
    'keep:set keep'
    'add:create or restore an entry'
    'drop:archive an entry'
    'restore:restore from dropped.json'
    'purge:permanently remove an entry'
    'migrate:apply inventory format migrations'
    'complete:shell completion helpers'
    'reset:delete all inventory data'
  )

  _arguments -C \
    '(- *)--version[print version]' \
    '--data-dir[inventory directory]:directory:_files -/' \
    '1:command:->cmd' \
    '*::arg:->args'

  case $state in
    cmd)
      _describe -t commands 'command' commands
      ;;
    args)
      case ${words[1]} in
        get|why|keep|drop|restore|add)
          if (( CURRENT == 2 )); then
            _vole_names
          fi
          ;;
        purge)
          if (( CURRENT == 2 )); then
            _vole_names
          else
            _arguments '--force[skip confirmation]'
          fi
          ;;
        list)
          ;;
        scan)
          _arguments \
            '--dry-run[report only]' \
            '--months[staleness months]:months:'
          ;;
        complete)
          if (( CURRENT == 2 )); then
            local -a csubs
            csubs=('names:list inventory names')
            _describe -t commands 'complete' csubs
          elif [[ ${words[2]} == names ]]; then
            _vole_names
          fi
          ;;
        reset)
          _arguments '--force[skip confirmation]'
          ;;
      esac
      ;;
  esac
}

_vole "$@"
