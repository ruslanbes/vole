#compdef vole
# zsh completion for vole — dynamic names via `vole complete names`.
# Installed to ~/.zsh/completions (curl/install.sh) or Homebrew's zsh completion dir.

_vole_names() {
  # Inventory names may contain spaces. The CLI takes a single argv token, so
  # the completed name must stay one shell word (quoted / backslash-escaped).
  # After Tab on a shared prefix like "Google\ ", zsh may still split later
  # keystrokes into extra words (CURRENT>2) — collapse those before matching.
  local name_start=2
  (( CURRENT < name_start )) && return 0

  if (( CURRENT > name_start )); then
    local joined=${(j: :)words[name_start,CURRENT]}
    joined=${joined//\\/}
    words=( "${(@)words[1,name_start-1]}" "$joined" "${(@)words[CURRENT+1,-1]}" )
    CURRENT=$name_start
  fi

  # Typed escapes (Google\ Do) must not reach the matcher or PREFIX compare.
  words[CURRENT]=${words[CURRENT]//\\/}
  local prefix=$words[CURRENT]
  PREFIX=$prefix
  SUFFIX=''
  [[ $prefix == -* ]] && return 0

  local -a names
  names=(${(f)"$(command vole complete names -- "$prefix" 2>/dev/null)"})
  (( $#names )) || return 0

  # No -Q: let zsh quote spaces so the line stays one argv token.
  compadd -- "${names[@]}"
}

_vole() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'help:show help'
    'scan:scan the machine and update inventory'
    'list:table of installed software'
    'get:show one inventory entry'
    'why:print or set why'
    'keep:set keep'
    'add:create or restore an entry'
    'drop:archive an entry'
    'restore:restore from dropped.json'
    'purge:permanently remove an entry'
    'migrate:apply inventory format migrations'
    'complete:shell completion helpers'
    'reset:delete all inventory data'
  )

  _arguments -C \
    '(- *)--version[print version]' \
    '--data-dir[inventory directory]:directory:_files -/' \
    '1:command:->cmd' \
    '*::arg:->args'

  case $state in
    cmd)
      _describe -t commands 'command' commands
      ;;
    args)
      case ${words[1]} in
        get|why|keep|drop|restore|add)
          if (( CURRENT >= 2 )); then
            _vole_names
          fi
          ;;
        purge)
          if (( CURRENT >= 2 )); then
            _vole_names
          else
            _arguments '--force[skip confirmation]'
          fi
          ;;
        list)
          ;;
        scan)
          _arguments \
            '--dry-run[report only]' \
            '--months[staleness months]:months:'
          ;;
        complete)
          if (( CURRENT == 2 )); then
            local -a csubs
            csubs=('names:list inventory names')
            _describe -t commands 'complete' csubs
          elif [[ ${words[2]} == names ]]; then
            _vole_names
          fi
          ;;
        reset)
          _arguments '--force[skip confirmation]'
          ;;
      esac
      ;;
  esac
}

_vole "$@"
